# Plantilla de variables de entorno.
# Este archivo sirve solo como guia y referencia.
# El servidor no usa este archivo directamente.
# En local se usa backend/.env.
# En produccion se usan variables reales del servidor o un .env real.
PORT=3000
WHATSAPP_WORKER_PORT=3001
APP_TIME_ZONE=America/Lima
DB_TIMEZONE=-05:00
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
APP_CSP_CONNECT_SRC='self',http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,ws://localhost:3000,ws://127.0.0.1:3000,ws://localhost:3001,ws://127.0.0.1:3001
APP_CSP_SCRIPT_SRC='self',https://cdn.jsdelivr.net,https://cdnjs.cloudflare.com
APP_CSP_STYLE_SRC='self','unsafe-inline',https://fonts.googleapis.com
APP_CSP_FONT_SRC='self',https://fonts.gstatic.com,data:
APP_CSP_IMG_SRC='self',data:,blob:,https://*.tile.openstreetmap.org
APP_CSP_MEDIA_SRC='self',data:,blob:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_mensajeria
# Overrides opcionales usados por Docker Compose para servicios en el host.
DOCKER_DB_HOST=host.docker.internal
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CONNECTION_NAME=myg-express
REDIS_LOG_THROTTLE_MS=30000
JWT_SECRET=cambia_esto_por_un_secreto_seguro
# Obligatorio: cifra las contrasenas Urbano guardadas por sede en urbano_credenciales_sede.
# Usa una cadena larga, privada y estable. Si la cambias, debes volver a guardar las credenciales.
URBANO_CREDENTIALS_SECRET=
URBANO_ROUTE_CACHE_TTL_MINUTES=45
WHATSAPP_JOB_ATTEMPTS=1
WHATSAPP_JOB_RETRY_DELAY_MS=120000
WHATSAPP_INTER_MESSAGE_DELAY_MS=25000
WHATSAPP_INTER_MESSAGE_JITTER_MS=8000
WHATSAPP_RATE_LIMIT_MAX=2
WHATSAPP_RATE_LIMIT_DURATION_MS=60000
WHATSAPP_BATCH_SIZE=15
WHATSAPP_BATCH_PAUSE_MS=300000
WHATSAPP_WORKER_CONCURRENCY=1
WHATSAPP_MEDIA_STRATEGY=always
WHATSAPP_MEDIA_TEXT_ONLY_AFTER_MESSAGES=35
WHATSAPP_ADAPTIVE_AFTER_MESSAGES=30
WHATSAPP_ADAPTIVE_EXTRA_DELAY_MS=60000
WHATSAPP_ADAPTIVE_STRONG_AFTER_MESSAGES=50
WHATSAPP_ADAPTIVE_STRONG_DELAY_MS=240000
WHATSAPP_HOURLY_HARD_LIMIT=45
WHATSAPP_HOURLY_HARD_COOLDOWN_MS=1800000
WHATSAPP_WORKER_REQUIRE_DB_LOCK=true
WHATSAPP_WORKER_LOCK_NAME=myg_express_whatsapp_worker
DB_CLEANUP_ENABLED=true
DB_CLEANUP_INTERVAL_MS=3600000
WHATSAPP_JOBS_RETENTION_DAYS=3
WHATSAPP_LOG_RETENTION_DAYS=30
WHATSAPP_SESSION_RETENTION_DAYS=30
WHATSAPP_MEDIA_RETENTION_DAYS=14

# Proveedor único de WhatsApp: Evolution API
EVOLUTION_API_URL=http://localhost:8080
DOCKER_EVOLUTION_API_URL=http://host.docker.internal:8080
EVOLUTION_API_APIKEY=tu_clave_api_global_de_evolution
EVOLUTION_API_WEBHOOK_URL=http://localhost:3000/api/whatsapp/webhook
