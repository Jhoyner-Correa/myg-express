{
  "name": "sistema-mensajeria-backend",
  "version": "1.0.0",
  "description": "Backend del sistema de mensajería masiva para logística",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test test/runtimeEnvironment.test.js test/servicePayment.test.js test/authorization.test.js test/time.test.js test/savarScanDomain.test.js test/deliveryDomain.test.js test/urbanoRouteDomain.test.js test/noticeImportDomain.test.js test/attendancePolicy.test.js test/attendanceOperationalState.test.js test/mobileSignature.test.js test/mobilePermissionRequest.test.js test/mobileAttendanceJustification.test.js test/gpsTrackingToken.test.js test/employeePolicy.test.js test/employeeCode.test.js test/employeePhotoStorage.test.js test/userPhotoStorage.test.js test/dniLookupService.test.js test/attendanceDashboard.test.js test/attendanceReport.test.js test/rrhhIncidents.test.js test/schedulePolicy.test.js test/workCalendarPolicy.test.js test/holidayCalendarPolicy.test.js test/selfieRetentionPolicy.test.js test/authProfile.test.js",
    "test:authorization": "npm run build && node --test test/authorization.test.js test/time.test.js",
    "db:preflight": "npm run build && node dist/scripts/checkDatabaseIntegrity.js",
    "db:repair:integrity": "npm run build && node dist/scripts/repairDatabaseIntegrity.js",
    "db:migrate": "npm run build && node dist/scripts/runMigrations.js",
    "db:migrate:integrity": "npm run db:repair:integrity && node dist/scripts/checkDatabaseIntegrity.js && node dist/scripts/applyIntegrityMigration.js",
    "db:migrate:savar-sede": "npm run build && node dist/scripts/applySavarSedeMigration.js",
    "db:migrate:rrhh-core": "npm run build && node dist/scripts/applyRrhhCoreFoundation.js",
    "db:migrate:rrhh-foundation": "npm run build && node dist/scripts/applyRrhhMobileFoundation.js",
    "db:migrate:rrhh-incidents": "npm run build && node dist/scripts/applyRrhhIncidentWorkflows.js",
    "db:migrate:rrhh-biometric-contingency": "npm run build && node dist/scripts/applyRrhhBiometricContingency.js",
    "db:migrate:rrhh-schedules": "npm run build && node dist/scripts/applyRrhhSchedulePolicies.js",
    "db:migrate:rrhh-calendar": "npm run build && node dist/scripts/applyRrhhWorkCalendar.js",
    "db:migrate:rrhh-weekly-scope": "npm run build && node dist/scripts/applyRrhhWeeklyScope.js",
    "db:migrate:rrhh-employee-codes": "npm run build && node dist/scripts/applyRrhhEmployeeCodes.js",
    "db:migrate:rrhh-employee-profile": "npm run build && node dist/scripts/applyRrhhEmployeeProfile.js",
    "db:migrate:rrhh-employee-photos": "npm run build && node dist/scripts/applyRrhhEmployeeProfilePhotos.js",
    "db:migrate:user-profile-photos": "npm run build && node dist/scripts/applyUserProfilePhotos.js",
    "db:migrate:rrhh-attendance-windows": "npm run build && node dist/scripts/applyRrhhAttendanceWindows.js",
    "db:migrate:rrhh-overtime-segments": "npm run build && node dist/scripts/applyRrhhOvertimeSegments.js",
    "db:migrate:rrhh-selfie-retention": "npm run build && node dist/scripts/applyRrhhSelfieRetention.js",
    "db:migrate:rrhh-attendance-closure": "npm run build && node dist/scripts/applyRrhhAttendanceDailyClosure.js",
    "db:migrate:rrhh-attendance-review": "npm run build && node dist/scripts/applyRrhhAttendanceReview.js",
    "db:migrate:rrhh-holidays": "npm run build && node dist/scripts/applyRrhhHolidayProposals.js",
    "db:migrate:rrhh-absence-cancellation": "npm run build && node dist/scripts/applyRrhhAbsenceCancellation.js",
    "db:migrate:rrhh-mobile-notifications": "npm run build && node dist/scripts/applyRrhhMobileNotifications.js",
    "db:migrate:rrhh-mobile-permissions": "npm run build && node dist/scripts/applyRrhhMobilePermissionRequests.js",
    "db:migrate:rrhh-attendance-justifications": "npm run build && node dist/scripts/applyRrhhAttendanceJustifications.js",
    "db:migrate:rrhh-payments": "npm run build && node dist/scripts/applyRrhhServicePayments.js",
    "db:migrate:rrhh-payment-workflow": "npm run build && node dist/scripts/applyRrhhPaymentWorkflow.js",
    "db:migrate:rrhh-payment-receipts": "npm run build && node dist/scripts/applyRrhhPaymentReceiptIntegrity.js",
    "db:migrate:rrhh-payment-legacy": "npm run build && node dist/scripts/applyRrhhPaymentLegacyBatches.js",
    "db:migrate:rrhh-payment-ledger": "npm run build && node dist/scripts/applyRrhhPaymentEmployeeLedger.js",
    "db:migrate:rrhh-payment-proration": "npm run build && node dist/scripts/applyRrhhPaymentProration.js",
    "db:migrate:rrhh-overtime-evidence": "npm run build && node dist/scripts/applyRrhhOvertimeEvidence.js",
    "db:migrate:rrhh-schema-governance": "npm run build && node dist/scripts/applyRrhhSchemaGovernance.js",
    "db:migrate:rrhh-legacy-retirement": "npm run build && node dist/scripts/applyRrhhLegacyRetirement.js",
    "db:migrate:access-model": "npm run build && node dist/scripts/applyAccessModel.js",
    "db:migrate:access-cleanup": "npm run build && node dist/scripts/applyAccessCleanup.js",
    "db:verify:access-model": "npm run build && node dist/scripts/verifyAccessCleanup.js",
    "db:verify:rrhh-schema": "npm run build && node dist/scripts/verifyRrhhSchema.js",
    "configurar:urbano-sede": "ts-node src/scripts/configurarUrbanoSede.ts",
    "configurar:paquetes": "ts-node src/scripts/crearPaquetesTable.ts",
    "start": "node dist/app.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
