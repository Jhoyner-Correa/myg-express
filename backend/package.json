{
  "name": "sistema-mensajeria-backend",
  "version": "1.0.0",
  "description": "Backend del sistema de mensajería masiva para logística",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "configurar:urbano-sede": "ts-node src/scripts/configurarUrbanoSede.ts",
    "configurar:paquetes": "ts-node src/scripts/crearPaquetesTable.ts",
    "start": "node dist/app.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.7",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
