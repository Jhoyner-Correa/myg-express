# Backend. En producción puede conservarse /api si el proxy inverso publica la API en el mismo dominio.
VITE_API_URL=/api

# Proveedor visual del mapa. Leaflet permanece como motor y esta URL puede cambiarse sin tocar el código.
# Para una instalación pequeña se utiliza OpenStreetMap respetando su política y atribución.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_PROVIDER_NAME=OpenStreetMap
VITE_MAP_ATTRIBUTION_TEXT=OpenStreetMap
VITE_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
VITE_MAP_MAX_ZOOM=19

# Las claves VITE_* se incluyen en el navegador. Si un proveedor exige una clave, debe ser pública
# y estar restringida por dominio desde el panel del proveedor; nunca coloque aquí una clave secreta.
